# Application Name (Change here to re-brand the entire system)
APP_NAME="Chukta"
NEXT_PUBLIC_APP_NAME="Chukta"

# Database (PostgreSQL / SQLite)
DATABASE_URL="postgresql://chukta:chukta123@localhost:5432/chukta_db?schema=public"
# For local dev without Docker, fallback: file:./dev.db

# Redis (Caching, Socket.IO Horizontal Adapter, BullMQ Queues)
REDIS_URL="redis://localhost:6379"

# S3 / MinIO Object Storage (Receipts & Avatars)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_RECEIPTS="receipts"
S3_BUCKET_AVATARS="avatars"
S3_FORCE_PATH_STYLE="true"

# Auth Secrets
JWT_SECRET="super-secret-jwt-key-chukta-min-32-chars-long"
JWT_REFRESH_SECRET="super-secret-refresh-key-chukta-min-32-chars-long"
COOKIE_SECRET="super-secret-cookie-key-chukta"

# Server Ports & URLs
PORT=4000
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Chatbot & External APIs
GEMINI_API_KEY=""
FX_RATES_API_KEY=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Transactional Email (SMTP / Mailpit dev mail catcher)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@chukta.app"

