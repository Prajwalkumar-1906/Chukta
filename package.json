{
  "name": "chukta-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --recursive --parallel run dev",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "lint": "pnpm --recursive run lint",
    "db:generate": "pnpm --filter @chukta/api run db:generate",
    "db:push": "pnpm --filter @chukta/api run db:push",
    "db:seed": "pnpm --filter @chukta/api run db:seed"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
